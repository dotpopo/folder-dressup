{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "文件夹换装",
  "version": "1.0.0",
  "identifier": "app.folderdressup.windows",
  "build": {
    "frontendDist": "../renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "文件夹换装",
        "width": 1280,
        "height": 820,
        "minWidth": 1100,
        "minHeight": 720,
        "backgroundColor": "#f4f5f7",
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
